# ─────────────────────────────────────────────────────────────────────────
# .env.example — template ONLY. Copy to a gitignored `.env` and fill in real
# values, OR (preferred for anything that runs in GitHub Actions) store the
# values as GitHub Actions repo secrets. NEVER put real values in this file,
# and NEVER commit a real `.env`.
#
# Add a value securely (value never appears in chat or shell history):
#   GitHub Actions secret:  pbpaste | gh secret set NTFY_TOKEN
#   Local .env:             echo "NTFY_TOKEN=$(pbpaste)" >> .env
# Read in code with: os.getenv("NTFY_TOKEN")
# ─────────────────────────────────────────────────────────────────────────

# ntfy — push notifications (curated-plays loop)
NTFY_TOKEN=

# Resend — transactional email API
RESEND_API_KEY=
